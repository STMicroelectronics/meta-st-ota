From e9bce8af7c20e2af639fcb01be7577efb25ef9db Mon Sep 17 00:00:00 2001
From: Christophe Guibout <christophe.guibout@st.com>
Date: Thu, 28 May 2026 16:04:13 +0200
Subject: [PATCH] support bin extension

Avoid the following error:
Unsupported image /run/rauc/bundle/fip-stm32mp135f-dk-optee.bin
for slot type raw
---
 src/update_handler.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/src/update_handler.c b/src/update_handler.c
index 56ea8d5..7101dd8 100644
--- a/src/update_handler.c
+++ b/src/update_handler.c
@@ -2730,6 +2730,7 @@ static RaucFileExtTypeMap ext_type_map[] = {
 	{"*.tgz", "tar"},
 	{"*.ext4", "ext4"},
 	{"*.vfat", "vfat"},
+	{"*.bin", "raw"},
 	{"*.img", "raw"},
 	{"*.squashfs-*", "squashfs"},
 	{"*.squashfs", "squashfs"},
-- 
