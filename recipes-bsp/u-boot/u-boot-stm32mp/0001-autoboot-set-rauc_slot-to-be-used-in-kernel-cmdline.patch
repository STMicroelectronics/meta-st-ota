From 0d9dadafca6df05da049498e011e18233b4ce3ff Mon Sep 17 00:00:00 2001
From: Christophe Guibout <christophe.guibout@st.com>
Date: Wed, 28 Oct 2026 11:58:21 +0100
Subject: [PATCH 1/2] autoboot: set rauc_slot to be used in kernel cmdline

Upstream-Status: Inappropriate [OTA specific]
Signed-off-by: Christophe Guibout <christophe.guibout@st.com>
---
 common/autoboot.c | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/common/autoboot.c b/common/autoboot.c
index 9dd8f88bfa7..6e9d085fc6c 100644
--- a/common/autoboot.c
+++ b/common/autoboot.c
@@ -496,10 +496,13 @@ const char *bootdelay_process(void)
 			boot_idx = bootcount_error();
 	}
 
-	if (boot_idx)
+	if (boot_idx) {
 		s = env_get("altbootcmd");
-	else
+		env_set("rauc_slot", "B");
+	} else {
 		s = env_get("bootcmd");
+		env_set("rauc_slot", "A");
+	}
 
 	if (IS_ENABLED(CONFIG_OF_CONTROL))
 		process_fdt_options();
-- 
