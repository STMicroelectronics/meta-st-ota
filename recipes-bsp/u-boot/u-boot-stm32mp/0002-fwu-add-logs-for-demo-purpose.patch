From 9dae99174450129b7945a95ed28c28f9ebcfe74d Mon Sep 17 00:00:00 2001
From: Christophe Guibout <christophe.guibout@st.com>
Date: Wed, 28 Oct 2026 11:58:31 +0100
Subject: [PATCH 2/2] fwu: add logs for demo purpose

Upstream-Status: Inappropriate [demo purpose only]
Signed-off-by: Christophe Guibout <christophe.guibout@st.com>
---
 common/autoboot.c        | 2 ++
 lib/fwu_updates/fwu.c    | 1 +
 lib/fwu_updates/fwu_v2.c | 6 ++++--
 3 files changed, 7 insertions(+), 2 deletions(-)

diff --git a/common/autoboot.c b/common/autoboot.c
index 6e9d085fc6c..357504a271e 100644
--- a/common/autoboot.c
+++ b/common/autoboot.c
@@ -497,9 +497,11 @@ const char *bootdelay_process(void)
 	}
 
 	if (boot_idx) {
+		printf("boot_idx=%u, call altbootcmd\n", boot_idx);
 		s = env_get("altbootcmd");
 		env_set("rauc_slot", "B");
 	} else {
+		printf("boot_idx=%u, call bootcmd\n", boot_idx);
 		s = env_get("bootcmd");
 		env_set("rauc_slot", "A");
 	}
diff --git a/lib/fwu_updates/fwu.c b/lib/fwu_updates/fwu.c
index b26b244cf85..94faf0616b7 100644
--- a/lib/fwu_updates/fwu.c
+++ b/lib/fwu_updates/fwu.c
@@ -795,6 +795,7 @@ static int fwu_boottime_checks(void)
 		log_err("Unable to read active_index\n");
 		return 0;
 	}
+	log_info("fwu: active_idx: %u\n", active_idx);
 
 	if (boot_idx != active_idx) {
 		log_info("Boot idx %u is not matching active idx %u, changing active_idx\n",
diff --git a/lib/fwu_updates/fwu_v2.c b/lib/fwu_updates/fwu_v2.c
index 159315b45b9..55d0423bc0e 100644
--- a/lib/fwu_updates/fwu_v2.c
+++ b/lib/fwu_updates/fwu_v2.c
@@ -65,14 +65,16 @@ static int fwu_mdata_sanity_checks(void)
 	num_banks = fwu_get_fw_desc(mdata)->num_banks;
 	num_images = fwu_get_fw_desc(mdata)->num_images;
 
+	log_info("fwu: Number of Banks(%u), Number of Images(%u)\n", num_banks, num_images);
+
 	if (num_banks != CONFIG_FWU_NUM_BANKS) {
-		log_err("Number of Banks(%u) in FWU Metadata different from the configured value(%d)",
+		log_err("Number of Banks(%u) in FWU Metadata different from the configured value(%d)\n",
 			num_banks, CONFIG_FWU_NUM_BANKS);
 		return -EINVAL;
 	}
 
 	if (num_images != CONFIG_FWU_NUM_IMAGES_PER_BANK) {
-		log_err("Number of Images(%u) in FWU Metadata different from the configured value(%d)",
+		log_err("Number of Images(%u) in FWU Metadata different from the configured value(%d)\n",
 			num_images, CONFIG_FWU_NUM_IMAGES_PER_BANK);
 		return -EINVAL;
 	}
-- 
